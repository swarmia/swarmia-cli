{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "[ ! -x \"${CLAUDE_PROJECT_DIR}/swarmia-cli\" ] || exec \"${CLAUDE_PROJECT_DIR}/swarmia-cli\" log-hook",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "[ ! -x \"${CLAUDE_PROJECT_DIR}/swarmia-cli\" ] || exec \"${CLAUDE_PROJECT_DIR}/swarmia-cli\" log-hook",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "[ ! -x \"${CLAUDE_PROJECT_DIR}/swarmia-cli\" ] || exec \"${CLAUDE_PROJECT_DIR}/swarmia-cli\" log-hook",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "[ ! -x \"${CLAUDE_PROJECT_DIR}/swarmia-cli\" ] || exec \"${CLAUDE_PROJECT_DIR}/swarmia-cli\" log-hook",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "[ ! -x \"${CLAUDE_PROJECT_DIR}/swarmia-cli\" ] || exec \"${CLAUDE_PROJECT_DIR}/swarmia-cli\" log-hook",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "[ ! -x \"${CLAUDE_PROJECT_DIR}/swarmia-cli\" ] || exec \"${CLAUDE_PROJECT_DIR}/swarmia-cli\" log-hook",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "[ ! -x \"${CLAUDE_PROJECT_DIR}/swarmia-cli\" ] || exec \"${CLAUDE_PROJECT_DIR}/swarmia-cli\" log-hook",
            "type": "command"
          }
        ]
      }
    ]
  }
}
